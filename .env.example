# Copy to .env, populate, then run: ./scripts/sync-secrets.sh

# --- CI / deploy-time (also usable locally via `wrangler login` / `supabase login` instead) ---
CLOUDFLARE_API_TOKEN=      # Cloudflare dashboard -> My Profile -> API Tokens (Workers deploy permissions)
CLOUDFLARE_ACCOUNT_ID=     # Cloudflare dashboard -> Workers & Pages -> right sidebar
SUPABASE_ACCESS_TOKEN=     # Supabase dashboard -> Account -> Access Tokens
SUPABASE_PROJECT_REF=      # Supabase project dashboard -> Project Settings -> General -> Reference ID
DATABASE_URL=              # Supabase project dashboard -> Project Settings -> Database -> Connection string (URI, use the pooler for serverless)

# --- App runtime (bound as Worker secrets via `wrangler secret put`) ---
SUPABASE_URL=               # Supabase project dashboard -> Project Settings -> API
SUPABASE_PUBLISHABLE_KEY=   # Supabase project dashboard -> Project Settings -> API (current key format; anon key is legacy)
SUPABASE_SECRET_KEY=        # Supabase project dashboard -> Project Settings -> API (current key format; service_role key is legacy. Never expose to the frontend)
LITELLM_API_KEY=            # LiteLLM proxy API key (OpenAI-compatible)
LITELLM_BASE_URL=           # LiteLLM proxy base URL, e.g. https://api.ai.it.ufl.edu
LITELLM_MODEL=               # Model alias configured on the LiteLLM proxy, e.g. gemma-4-31b-it
STRIPE_SECRET_KEY=          # Stripe dashboard -> Developers -> API keys
STRIPE_WEBHOOK_SECRET=      # Stripe dashboard -> Developers -> Webhooks -> signing secret for the endpoint
STRIPE_PUBLISHABLE_KEY=     # Stripe dashboard -> Developers -> API keys (safe for the frontend bundle)
STRIPE_PRICE_ID_PLUS=       # Stripe dashboard -> Product catalog -> "Plus" price ($9/mo)
STRIPE_PRICE_ID_PRO=        # Stripe dashboard -> Product catalog -> "Pro" price ($24/mo)
SEMANTIC_SCHOLAR_API_KEY=   # Semantic Scholar API sign-up form (optional, raises rate limit)
CROSSREF_CONTACT_EMAIL=     # Your own contact email, per CrossRef's polite-pool usage policy (not secret)
UNPAYWALL_CONTACT_EMAIL=    # Your own contact email, required by Unpaywall's usage policy (not secret)
PUBLIC_APP_URL=             # http://localhost:8787 locally; production domain in prod
